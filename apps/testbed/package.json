{
  "name": "testbed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#backend/*": "./src/backend/*",
    "#contract/*": "./src/contract/*",
    "#e2e/*": "./src/e2e/*",
    "#web/*": "./src/web/*",
    "#test/*": "./test/*",
    "#scripts/*": "./scripts/*",
    "#root/*": "./*"
  },
  "scripts": {
    "dev:alchemy": "bash -c 'environment=$(vpx scripts/web.ts) && stage=$(vpx scripts/stage.ts \"$environment\") && printf \"{\\\"port\\\":%s,\\\"url\\\":\\\"%s\\\"}\" \"$BACKEND_PORT\" \"$APP_URL\" > \"${RIGGING_ENDPOINT:?start the server with vp run dev or vp run e2e:start}\" && env -u FORCE_COLOR NO_COLOR=1 WEBSITE_PORT=$BACKEND_PORT alchemy dev --stage \"$stage\"; kill -TERM 0'",
    "dev": "vpx scripts/dev.ts start",
    "dev:stop": "rigging server stop dev",
    "dev:status": "vpx scripts/dev.ts status",
    "dev:logs": "rigging server logs dev",
    "e2e:start": "vpx scripts/e2e.ts start",
    "e2e:stop": "rigging server stop e2e",
    "e2e:status": "vpx scripts/e2e.ts status",
    "e2e:restart": "vpx scripts/e2e.ts restart",
    "e2e:logs": "rigging server logs e2e",
    "browser": "vpx --env-file=.env scripts/browser.ts",
    "test:unit": "vp test run --project unit",
    "test:integ": "vp test run --project integ",
    "test:e2e": "vp exec playwright test",
    "deploy:staging": "alchemy deploy --stage staging --yes",
    "stage": "rigging stage",
    "logs": "rigging logs"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/atom-react": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/sql-sqlite-do": "4.1.2",
    "@mw10013/rigging": "catalog:",
    "@mw10013/shopify-app-cloudflare": "workspace:*",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.85",
    "@alchemy.run/test": "2.0.0-beta.85",
    "@cloudflare/workers-types": "5.20261026.1",
    "@effect/vitest": "4.1.2",
    "@shopify/polaris-types": "2.0.0",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "seroval": "1.7.9",
    "smol-toml": "1.9.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
